# Base URL of the IndexMeNow backend API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5050

# Public origin of this site, used in sitemap.xml and robots.txt (no trailing slash).
# Optional: defaults to https://storewike.store
NEXT_PUBLIC_SITE_URL=https://storewike.store

# Contact address shown on the privacy policy and terms (questions, data deletion requests).
# Set this before going live.
NEXT_PUBLIC_CONTACT_EMAIL=
